# Copy to .env and adjust for local development.

# --- Database ---
DATABASE_URL=postgresql+psycopg://release_guardian:release_guardian@localhost:5432/release_guardian

# --- Queue ---
REDIS_URL=redis://localhost:6379/0
WORKER_MODE=celery

# --- Security (override in every real environment) ---
JWT_SECRET=change-me-in-production
WEBHOOK_SIGNING_SECRET=change-me-webhook-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Runtime ---
ENVIRONMENT=development
API_PREFIX=/api/v1
RUN_TIMEOUT_SECONDS=300
PENDING_RUN_TIMEOUT_SECONDS=120
STEP_TIMEOUT_SECONDS=60
MAX_REDIRECTS=5
ALLOW_PRIVATE_URLS=false
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
METRICS_ENABLED=true

# --- Limits and backpressure ---
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_API_PER_MINUTE=300
# auto = redis in celery mode, memory in inline mode
RATE_LIMIT_BACKEND=auto
MAX_ACTIVE_RUNS_PER_MONITOR=1
MAX_ACTIVE_RUNS_PER_WORKSPACE=50

# --- Object storage (optional) ---
S3_ENDPOINT_URL=
S3_BUCKET=release-guardian
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_USE_SSL=true
S3_FORCE_PATH_STYLE=false
# Signed artifact URLs expire quickly; clients request a fresh URL via the API.
ARTIFACT_URL_TTL_SECONDS=900

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
