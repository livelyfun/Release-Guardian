# Copy to .env and adjust for local development.

# --- Database ---
DATABASE_URL=postgresql+psycopg://release_guardian:release_guardian@localhost:5432/release_guardian

# --- Queue ---
REDIS_URL=redis://localhost:6379/0
WORKER_MODE=celery

# --- Security (override in every real environment) ---
JWT_SECRET=change-me-in-production
WEBHOOK_SIGNING_SECRET=change-me-webhook-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Runtime ---
ENVIRONMENT=development
API_PREFIX=/api/v1
RUN_TIMEOUT_SECONDS=300
STEP_TIMEOUT_SECONDS=60
MAX_REDIRECTS=5
ALLOW_PRIVATE_URLS=false
CORS_ORIGINS=["http://localhost:3000"]

# --- Object storage (optional) ---
S3_ENDPOINT_URL=
S3_BUCKET=release-guardian
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
