{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (route) (rate(rg_api_requests_total[5m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "title": "API request rate by route",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(rg_api_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(rg_api_requests_total[5m])), 0.001)",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ],
      "title": "API 5xx ratio",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(rg_api_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(rg_api_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "B"
        }
      ],
      "title": "API latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "sum by (status) (increase(rg_runs_total[1h]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "title": "Run outcomes (1h)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 5,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(rg_run_duration_seconds_bucket[15m])) by (le, kind))",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "title": "Run duration p95 by kind",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 6,
      "targets": [
        {
          "expr": "time() - rg_scheduler_last_success_timestamp_seconds",
          "legendFormat": "scheduler age",
          "refId": "A"
        },
        {
          "expr": "time() - rg_sweeper_last_success_timestamp_seconds",
          "legendFormat": "sweeper age",
          "refId": "B"
        }
      ],
      "title": "Scheduler and sweeper freshness",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 7,
      "targets": [
        { "expr": "rg_pending_runs", "legendFormat": "pending runs", "refId": "A" },
        {
          "expr": "rg_oldest_pending_run_age_seconds",
          "legendFormat": "oldest pending age (s)",
          "refId": "B"
        }
      ],
      "title": "Queue backlog",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 8,
      "targets": [
        {
          "expr": "sum by (status) (rate(rg_notification_attempts_total[15m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        },
        {
          "expr": "sum by (status) (rate(rg_escalations_total[15m]))",
          "legendFormat": "escalation {{status}}",
          "refId": "B"
        }
      ],
      "title": "Notifications and escalations",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "id": 9,
      "targets": [
        {
          "expr": "sum by (kind, status) (rate(rg_artifact_uploads_total[15m]))",
          "legendFormat": "{{kind}} {{status}}",
          "refId": "A"
        }
      ],
      "title": "Artifact uploads",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "id": 10,
      "targets": [
        {
          "expr": "sum by (reason) (rate(rg_blocked_urls_total[15m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(rg_artifacts_pruned_total[1h]))",
          "legendFormat": "artifacts pruned",
          "refId": "B"
        }
      ],
      "title": "SSRF rejections and artifact pruning",
      "type": "timeseries"
    }
  ],
